{
  "name": "agent-switch",
  "version": "0.5.0",
  "description": "Run Claude Code on several subscriptions from one machine: switch accounts per session, see each one's limits, and move to the account with room before you hit a wall.",
  "license": "MIT",
  "author": "Pavan Kalvakota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galawaydude/agent-switch.git"
  },
  "homepage": "https://github.com/galawaydude/agent-switch#readme",
  "bugs": "https://github.com/galawaydude/agent-switch/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "accounts",
    "subscriptions",
    "cli"
  ],
  "type": "module",
  "bin": {
    "agent-switch": "dist/cli.js",
    "asw": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "!dist/**/*.test.js",
    "!dist/test-helpers.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=spec dist/*.test.js",
    "clean": "rm -rf dist",
    "pack:release": "npm run build && npm pack"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
